# 忽略所有 .o 文件
*.o

# 忽略所有 .d 文件
*.d

*.obj

build.md

# 仅忽略根目录下的 devel 目录
/devel/

/build/
/output/
/Module/build/
/third_party/archives/
/CMakeUserPresets.json
/third_party/jsoncpp-1.9.5/
/third_party/glad-0.1.36/
/third_party/glfw-3.4/
/tools/*
!/tools/import_brotato_*.py
!/tools/brotato_scene.py
!/tools/install_iwanna_apple_monster.py
!/tools/add_iwanna_apple_monster_demo.py
/build/

/Log/

# Generated libraries for the IWanna port.
/lib/debug/audio_module.lib
/lib/debug/iwanna_module.lib
/lib/debug/scripting_module.lib
/lib/debug/iwanna_lua.lib

# 忽略 bin 目录下的所有文件和目录，除了 shaders 目录
/bin/*
!/bin/shaders/



# Local level editor recovery files.
*.editor.bak
*.editor.tmp
*.editor.old

# Reproducible local intermediate model packages (source assets stay separate).
/Asset/Generated/

# Asset payloads stay local; retain source code and runtime/import configuration.
/Asset/**
!/Asset/**/
!/Asset/**/*.c
!/Asset/**/*.cpp
!/Asset/**/*.h
!/Asset/**/*.hpp
!/Asset/**/*.inl
!/Asset/**/*.cs
!/Asset/**/*.js
!/Asset/**/*.py
!/Asset/**/*.lua
!/Asset/**/*.glsl
!/Asset/**/*.vert
!/Asset/**/*.frag
!/Asset/**/*.geom
!/Asset/**/*.comp
!/Asset/**/*.hlsl
!/Asset/**/*.json
!/Asset/**/*.json5
!/Asset/**/*.yaml
!/Asset/**/*.yml
!/Asset/**/*.toml
!/Asset/**/*.ini
!/Asset/**/*.cfg
!/Asset/**/*.tmj
!/Asset/**/*.tsj
!/Asset/**/*.tiled-project

# Raw model bundles also contain JSON export reports/sidecars, not project config.
/Asset/Model/
/Asset/Generated/

# Python cache files are generated, including those alongside asset scripts.
__pycache__/
*.py[cod]
